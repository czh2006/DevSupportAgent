DEVSUPPORT_APP_NAME=DevSupport Agent
DEVSUPPORT_APP_ENV=development

# LLM 配置：默认关闭，完成后续 LLM 提取器时再改为 true
DEVSUPPORT_LLM_ENABLED=false

# 使用 OpenAI 兼容接口时填写。不要把真实 Key 提交到 Git。
# DEVSUPPORT_LLM_API_KEY=
# DEVSUPPORT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEVSUPPORT_LLM_MODEL=qwen-plus
# 本地演示服务
DEMO_API_KEY=demo-local-key
DEMO_PROJECT_ID=demo-project
DEMO_UPSTREAM_URL=http://127.0.0.1:8011/v1/answer
DEMO_UPSTREAM_TIMEOUT_SECONDS=2
DEMO_RATE_LIMIT_REQUESTS=3
DEMO_RATE_LIMIT_WINDOW_SECONDS=30
# MCP 日志查询
DEVSUPPORT_MCP_LOG_URL=http://127.0.0.1:8012/mcp
DEVSUPPORT_MCP_LOG_PROJECT_ID=demo-project
DEVSUPPORT_MCP_LOG_TIMEOUT_SECONDS=5